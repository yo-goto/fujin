// fujin 用グローバルキーバインド（config.kdl に追記する）
//
// `make setup`（= extras/setup.sh）を使うと、下の内容のうち貼るべき部分を
// いまの環境向けに出力してくれる。このファイルは全体像を読みたいとき用。
//
// MessagePlugin は URL/エイリアス指定なので全インスタンスに届く（決定6）。
// MessagePluginId は使わない — タブ数ぶんのインスタンスが同じキーを
// 奪い合って衝突するため。
//
// ============================================================
// 前提: エイリアスを定義しておく
// ============================================================
// wasm のパスを1箇所にまとめられるうえ、レイアウト側とキーバインド側で
// **設定（configuration）が食い違う事故を防げる**。
//
// MessagePlugin の宛先照合はパスだけでなく configuration 込みで行われる。
// 食い違うと常駐サイドバーには届かず、zellij が「設定の一致する新しい
// インスタンス」をその場に開く（実測）。fujin は unselectable なので、
// そうしてできたペインは誰にも閉じられない。
//
// plugins {
//     fujin location="file:~/.config/zellij/plugins/fujin.wasm" {
//         // 設定はここに書く。レイアウト側にだけ書いてはいけない
//         // show_cwd "true"
//         //
//         // 非フォーカス時にフッターへ出すキー表記（表示専用。割り当てではない）。
//         // 下の direct-keys に割り当てたキーをそのまま書き写す。
//         // zellij の表記（"Alt u"）でも画面表記（"alt+u"）でもよい
//         // up_key   "Alt u"
//         // down_key "Alt d"
//         // go_key   "Alt g"
//     }
// }
//
// `file:~/…` の `~` は zellij が展開するので、ホームディレクトリ名は書かなくてよい。
// 開発中は debug ビルドを直接指してもよい（相対パスは不可）:
//   file:/path/to/repos/main/target/wasm32-wasip1/debug/fujin.wasm
//
// ============================================================
// 推奨: navモード方式（決定12）
// ============================================================
// zellij本体の Ctrl+p → pane モードと同じ操作感。config.kdl に書くのは
// 「入場キー1つ」だけで、モード内のキー（j/k/Enter/Esc…）はプラグインが
// 自前で解釈する。ビルトインモードを1つ潰す必要がない。
//
// モード内のキー（プラグイン側に実装、config.kdl には書かない）:
//   j / ↓ / Tab   次のペイン
//   k / ↑         前のペイン
//   g / G         先頭 / 末尾
//   1-9           n番目へ直行してモードを抜ける
//   Enter / l / Space  選択中のペインへジャンプしてモードを抜ける
//   Esc / q       モードを抜ける
//   （その他のキーも抜ける — キー入力が取り残されないための安全弁）
//
// keybinds {
//     shared_except "locked" {
//         bind "Ctrl y" {
//             MessagePlugin "fujin" {
//                 name "fujin_mode"
//                 floating true
//             }
//         }
//     }
// }
//
// Ctrl+y は zellij のデフォルトと衝突しない空きキー。使用中なら Ctrl+e など任意に。
// （既定で埋まっているのは p/t/n/h/s/o/q/g）
//
// **`floating true` は必ず書くこと。** セッションに fujin が1つも居ない場合
// （レイアウトを使わずに作ったセッション等）、この pipe には宛先が無いので
// zellij 自身が fujin を新規起動する。既定ではタイルで開くため、作業ペインを
// 分割して右側に中途半端な幅で出てしまい、プラグイン側からは直せない。
// `floating true` を書いておけばフローティングで開き、fujin が自分で
// 常駐サイドバーと同じ左端・幅32へ整える（Esc やジャンプで閉じる）。
// 既に fujin が起動しているときの配送には影響しない。
//
// ============================================================
// 代替: モードなしの直接キー
// ============================================================
// モードに入らず1打鍵で動かしたい場合。navモードと併用してもよい。
// `fujin_toggle_cwd` は移動ではなく、cwd行（`show_cwd`）の表示を実行中に反転する。
//
// keybinds {
//     shared_except "locked" {
//         bind "Alt u"     { MessagePlugin "fujin" { name "fujin_up"; }; }
//         bind "Alt d"     { MessagePlugin "fujin" { name "fujin_down"; }; }
//         bind "Alt g"     { MessagePlugin "fujin" { name "fujin_go"; }; }
//         bind "Alt c"     { MessagePlugin "fujin" { name "fujin_toggle_cwd"; }; }
//     }
// }
//
// **`Alt Enter` にバインドしてはいけない。** Claude Code の Shift+Enter は
// 端末側の設定（`/terminal-setup` が入れる `Shift+Return -> ESC CR`）に依存していて、
// zellij はその ESC CR を Alt+Enter として解釈する。`Alt Enter` を奪うと
// Shift+Enter の改行がペインに届かなくなる。詳細は docs/dev/api-reference.md。
